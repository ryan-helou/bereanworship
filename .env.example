# ---------------------------------------------------------------------------
# BereanWorship — environment variables
# Copy to `.env` for local development. NEVER commit a filled-in .env.
# ---------------------------------------------------------------------------

# --- Database (required) ---------------------------------------------------
# PostgreSQL connection string. Railway provides this automatically when a
# Postgres plugin is attached; locally point it at your own instance.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bereanworship?schema=public"

# --- Admin authentication (required) ---------------------------------------
# Secret used to sign admin session cookies (HS256). Must be >= 32 characters.
# Generate with: openssl rand -base64 48
ADMIN_AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# The single admin account. The password is never stored — only a scrypt hash
# derived from ADMIN_PASSWORD_HASH is compared at login.
ADMIN_EMAIL="admin@bereanworship.org"

# Generate with: npm run -s admin:hash -- 'your-password'
#   (or: node scripts/hash-password.mjs 'your-password')
# Format: scrypt$N$r$p$<salt-b64>$<hash-b64>
ADMIN_PASSWORD_HASH=""

# --- Site password gate ------------------------------------------------------
# The WHOLE site sits behind a password. A visitor enters it at /enter and gets
# a read-only pass for the public pages; it is not an admin session.
#
# Optional: a password that opens the site and nothing else, so it can be given
# to others without giving them the admin area. When unset, the gate accepts the
# admin password instead, so it works with nothing new to configure.
# Generate with: node scripts/hash-password.mjs 'the-site-password'
SITE_PASSWORD_HASH=""

# Set to "off" to reopen the site to everyone without a code change.
SITE_GATE=""

# --- AI research pipeline (required for running reviews) --------------------
# Anthropic API key used by the multi-stage review pipeline.
# Without this the app runs read-only: browsing works, but review jobs fail
# fast with a clear "AI provider not configured" error.
ANTHROPIC_API_KEY=""

# Model used for analysis stages. Defaults to claude-opus-5 when unset.
ANTHROPIC_MODEL="claude-opus-5"

# Optional: override the API base URL (proxies / gateways).
# ANTHROPIC_BASE_URL=""

# --- Worker ----------------------------------------------------------------
# How many review jobs the worker processes concurrently.
WORKER_CONCURRENCY="2"
# Milliseconds between queue polls when idle.
WORKER_POLL_INTERVAL_MS="4000"
# Max attempts before a job is parked in `failed`.
WORKER_MAX_ATTEMPTS="3"
# Set to "false" on the web service if you run a dedicated worker service.
# When "true", the web process also runs an in-process worker loop (handy for
# single-service deployments and local development).
RUN_INLINE_WORKER="false"

# --- Application -----------------------------------------------------------
# Canonical public origin — used for SEO canonical URLs, sitemap and OG tags.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Node environment. Railway sets this to "production" automatically.
NODE_ENV="development"
