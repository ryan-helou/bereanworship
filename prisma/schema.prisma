// BereanWorship — data model
// "Test what you sing."
//
// Two independent evaluations live side by side in this schema:
//   * Song validity   (Song.overallScore)   — the song itself
//   * Artist validity (Artist.overallScore) — the artist/ministry behind it
// There is deliberately NO foreign-key-driven arithmetic between the two.
// Artist scores never feed song scores; see docs/SCORING.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum ArtistType {
  INDIVIDUAL
  GROUP
  MINISTRY
  CHURCH
  COLLECTIVE
  UNKNOWN
}

enum Recommendation {
  RECOMMENDED
  RECOMMENDED_WITH_CAUTION
  NOT_RECOMMENDED
}

enum ReviewStatus {
  UNREVIEWED
  QUEUED
  IN_PROGRESS
  COMPLETED
  FAILED
  NEEDS_ATTENTION
}

enum FindingType {
  STRENGTH
  CONCERN
}

/// Shared weight scale.
/// CONCERN  → MINOR / MODERATE / MAJOR / SEVERE  (penalty tiers)
/// STRENGTH → MINOR / MODERATE / MAJOR           (credit tiers; SEVERE invalid)
enum Severity {
  MINOR
  MODERATE
  MAJOR
  SEVERE
}

/// How central the affected doctrine is to the Christian faith.
/// Scales the penalty: a questionable metaphor is not a false gospel.
enum Centrality {
  CORE
  IMPORTANT
  PERIPHERAL
}

/// Which of the three song components a finding scores against.
enum ScoreComponent {
  THEOLOGICAL
  COMMUNAL
  CLARITY
}

/// Which of the four artist components a finding scores against.
enum ArtistComponent {
  DOCTRINE
  AFFILIATIONS
  PUBLIC_TEACHING
  MINISTRY_CONTEXT
}

/// Epistemic status of a claim. Enforced by the research prompts and used to
/// stop allegations being rendered as established fact.
enum EvidenceGrade {
  DIRECT_STATEMENT
  DOCUMENTED_FACT
  CREDIBLE_REPORTING
  ALLEGATION
  INTERPRETATION
  THEOLOGICAL_INFERENCE
}

enum SourceType {
  OFFICIAL_WEBSITE
  STATEMENT_OF_FAITH
  INTERVIEW
  SERMON
  BOOK
  PUBLICATION
  ACADEMIC
  THEOLOGICAL_ORGANIZATION
  JOURNALISM
  BLOG
  SOCIAL_MEDIA
  LYRICS_DATABASE
  OTHER
}

/// TIER_1 primary · TIER_2 highly reputable secondary
/// TIER_3 general journalism · TIER_4 blogs / forums / social media
enum CredibilityTier {
  TIER_1
  TIER_2
  TIER_3
  TIER_4
}

enum JobType {
  SONG_REVIEW
  ARTIST_RESEARCH
  ARTIST_REFRESH
}

enum JobStatus {
  PENDING
  RESEARCHING
  ANALYZING
  SCORING
  COMPLETED
  FAILED
  NEEDS_REVIEW
  CANCELLED
}

enum RequestStatus {
  PENDING
  QUEUED
  COMPLETED
  ALREADY_REVIEWED
  DUPLICATE
  REJECTED
}

// ---------------------------------------------------------------------------
// Artists
// ---------------------------------------------------------------------------

model Artist {
  id             String     @id @default(cuid())
  /// Human-facing name, exactly as it should be rendered.
  displayName    String
  /// Canonical name used for identity decisions (trimmed, collapsed spaces).
  canonicalName  String
  /// Aggressively normalized key: lowercase, punctuation/diacritics stripped.
  normalizedName String     @unique
  slug           String     @unique
  type           ArtistType @default(UNKNOWN)

  /// Alternate spellings and former names, normalized. Used by search + import.
  aliases     String[] @default([])
  country     String?
  foundedYear Int?
  websiteUrl  String?
  bio         String?  @db.Text

  // --- Artist validity (independent of every song score) ---
  overallScore          Int?
  doctrineScore         Int?
  affiliationScore      Int?
  publicTeachingScore   Int?
  ministryContextScore  Int?
  recommendation        Recommendation?
  summary               String?         @db.Text
  /// Set when sources genuinely disagree; rendered verbatim on the artist page.
  evidenceCaveat        String?         @db.Text

  reviewStatus      ReviewStatus @default(UNREVIEWED)
  reviewVersion     String?
  scoringVersion    String?
  methodologyVersion String?
  reviewedAt        DateTime?
  lastReviewedAt    DateTime?
  reviewError       String?      @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Maintained by a database trigger (see the `search` migration). Covers the
  /// display name, canonical name and every alias.
  searchVector Unsupported("tsvector")?

  songs    Song[]
  findings ArtistFinding[]
  sources  ArtistSource[]
  jobs     ReviewJob[]
  history  ReviewHistory[]

  @@index([searchVector], type: Gin)
  @@index([normalizedName])
  @@index([overallScore])
  @@index([reviewStatus])
  @@index([reviewedAt])
  @@index([createdAt])
  @@index([slug])
  @@map("artists")
}

model ArtistFinding {
  id        String  @id @default(cuid())
  artistId  String
  artist    Artist  @relation(fields: [artistId], references: [id], onDelete: Cascade)

  type      FindingType
  component ArtistComponent
  severity  Severity
  category  String
  title     String
  explanation String   @db.Text

  /// Short factual evidence excerpt. Never a wholesale reproduction.
  evidence      String?       @db.Text
  evidenceGrade EvidenceGrade @default(INTERPRETATION)
  /// True when the supporting sources conflict; surfaced in the UI.
  contested     Boolean       @default(false)

  /// Signed points this finding contributed to its component (audit trail).
  scoreImpact Float @default(0)

  sourceId String?
  source   Source? @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([artistId])
  @@index([artistId, type])
  @@index([component])
  @@index([severity])
  @@map("artist_findings")
}

// ---------------------------------------------------------------------------
// Songs
// ---------------------------------------------------------------------------

model Song {
  id              String  @id @default(cuid())
  displayTitle    String
  canonicalTitle  String
  /// Aggressively normalized title. Unique *per artist*, not globally —
  /// two different artists may legitimately share a title.
  normalizedTitle String
  slug            String  @unique

  artistId String
  artist   Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)

  album       String?
  releaseYear Int?
  genre       String?
  ccliNumber  String?

  // --- Song validity: 60 / 20 / 20 ---
  overallScore     Int?
  theologicalScore Int?
  communalScore    Int?
  clarityScore     Int?
  recommendation   Recommendation?
  summary          String?         @db.Text

  // --- Vocal range ---
  /// Congregational range difficulty, 0-100, higher is easier to sing.
  /// Reported separately and never folded into overallScore: range is a
  /// property of the key an arrangement is published in, not of the song, and
  /// transposing changes it. Null means not measured — never estimated.
  rangeScore         Int?
  /// Lowest and highest melody notes in scientific pitch notation, e.g. "A3".
  rangeLowest        String?
  rangeHighest       String?
  /// Where the melody mostly sits, which matters more than the extremes.
  rangeTessituraLow  String?
  rangeTessituraHigh String?
  /// Key the measurement was taken in — the numbers only mean anything with it.
  rangeKey           String?
  /// Where the pitches were read from (chart, lead sheet, hymnal).
  rangeSource        String?
  rangeNote          String?      @db.Text

  reviewStatus       ReviewStatus @default(UNREVIEWED)
  reviewVersion      String?
  scoringVersion     String?
  methodologyVersion String?
  reviewedAt         DateTime?
  lastReviewedAt     DateTime?
  reviewError        String?      @db.Text
  /// Flagged by an admin as needing a human look.
  needsAttention     Boolean      @default(false)
  attentionNote      String?      @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Maintained by a database trigger (see the `search` migration). Covers the
  /// title, album and genre. Artist matches are reached through the join.
  searchVector Unsupported("tsvector")?

  findings   SongFinding[]
  themes     SongTheme[]
  sources    SongSource[]
  scriptures SongScripture[]
  jobs       ReviewJob[]
  requests   SongRequest[]
  history    ReviewHistory[]

  @@index([searchVector], type: Gin)
  @@unique([artistId, normalizedTitle], name: "song_identity")
  @@index([normalizedTitle])
  @@index([artistId])
  @@index([overallScore])
  @@index([theologicalScore])
  @@index([communalScore])
  @@index([clarityScore])
  @@index([rangeScore])
  @@index([reviewStatus])
  @@index([recommendation])
  @@index([reviewedAt])
  @@index([createdAt])
  @@index([displayTitle])
  @@map("songs")
}

model SongFinding {
  id     String @id @default(cuid())
  songId String
  song   Song   @relation(fields: [songId], references: [id], onDelete: Cascade)

  type       FindingType
  component  ScoreComponent
  severity   Severity
  centrality Centrality  @default(IMPORTANT)
  category   String
  title      String
  explanation String     @db.Text

  /// Very short lyric excerpt (hard-capped at 10 words by the validator).
  lyricExcerpt       String?
  scriptureReference String?
  scriptureExcerpt   String? @db.Text
  /// Why the cited passage matters to this finding.
  scriptureRationale String? @db.Text

  /// True when the issue recurs (e.g. it sits in the refrain) — amplifies the
  /// penalty because the congregation sings it repeatedly.
  recurring Boolean @default(false)

  /// Signed points this finding contributed to its component (audit trail).
  scoreImpact Float @default(0)

  createdAt DateTime @default(now())

  @@index([songId])
  @@index([songId, type])
  @@index([component])
  @@index([severity])
  @@index([category])
  @@map("song_findings")
}

model SongScripture {
  id        String @id @default(cuid())
  songId    String
  song      Song   @relation(fields: [songId], references: [id], onDelete: Cascade)
  reference String
  /// Brief ESV excerpt — references and reasoning carry the weight, not text dumps.
  excerpt   String? @db.Text
  relevance String  @db.Text
  ordering  Int     @default(0)

  @@unique([songId, reference])
  @@index([songId])
  @@map("song_scriptures")
}

// ---------------------------------------------------------------------------
// Themes
// ---------------------------------------------------------------------------

model Theme {
  id          String  @id @default(cuid())
  name        String  @unique
  slug        String  @unique
  description String?
  ordering    Int     @default(0)

  songs SongTheme[]

  @@index([slug])
  @@map("themes")
}

model SongTheme {
  songId  String
  themeId String
  song    Song  @relation(fields: [songId], references: [id], onDelete: Cascade)
  theme   Theme @relation(fields: [themeId], references: [id], onDelete: Cascade)

  @@id([songId, themeId])
  @@index([themeId])
  @@map("song_themes")
}

// ---------------------------------------------------------------------------
// Sources
// ---------------------------------------------------------------------------

model Source {
  id              String          @id @default(cuid())
  url             String          @unique
  title           String
  publisher       String?
  author          String?
  publicationDate DateTime?
  accessedAt      DateTime        @default(now())
  sourceType      SourceType      @default(OTHER)
  credibilityTier CredibilityTier @default(TIER_3)
  summary         String?         @db.Text
  /// Notes on retrieval — e.g. "publisher's own statement of faith page".
  notes           String?         @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  songLinks      SongSource[]
  artistLinks    ArtistSource[]
  artistFindings ArtistFinding[]

  @@index([credibilityTier])
  @@index([sourceType])
  @@index([publisher])
  @@map("sources")
}

model SongSource {
  songId   String
  sourceId String
  song     Song   @relation(fields: [songId], references: [id], onDelete: Cascade)
  source   Source @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  /// What this source established for this song.
  relevance String? @db.Text

  @@id([songId, sourceId])
  @@index([sourceId])
  @@map("song_sources")
}

model ArtistSource {
  artistId  String
  sourceId  String
  artist    Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)
  source    Source @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  relevance String? @db.Text

  @@id([artistId, sourceId])
  @@index([sourceId])
  @@map("artist_sources")
}

// ---------------------------------------------------------------------------
// Review pipeline
// ---------------------------------------------------------------------------

model ReviewJob {
  id     String    @id @default(cuid())
  type   JobType
  status JobStatus @default(PENDING)

  songId   String?
  song     Song?   @relation(fields: [songId], references: [id], onDelete: Cascade)
  artistId String?
  artist   Artist? @relation(fields: [artistId], references: [id], onDelete: Cascade)

  /// Raw request payload — title/artist as submitted, batch metadata, etc.
  payload Json?

  /// Groups jobs created by one bulk import so progress can be reported.
  batchId String?

  priority    Int       @default(0)
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  lastError   String?   @db.Text
  /// Human-readable trace of pipeline stages for admin inspection.
  stageLog    Json?

  /// Cooperative lock: set when a worker claims the job.
  lockedAt    DateTime?
  lockedBy    String?
  /// Earliest time the job may be picked up (used for retry backoff).
  runAfter    DateTime  @default(now())

  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, runAfter])
  @@index([status])
  @@index([type])
  @@index([batchId])
  @@index([songId])
  @@index([artistId])
  @@index([createdAt])
  @@map("review_jobs")
}

model ImportBatch {
  id             String   @id @default(cuid())
  label          String?
  submittedCount Int      @default(0)
  duplicateCount Int      @default(0)
  existingCount  Int      @default(0)
  queuedCount    Int      @default(0)
  invalidCount   Int      @default(0)
  /// Parse warnings and per-row outcomes for the admin results screen.
  report         Json?
  createdAt      DateTime @default(now())

  @@index([createdAt])
  @@map("import_batches")
}

model SongRequest {
  id String @id @default(cuid())

  /// Exactly what the visitor typed — kept for support/debugging.
  rawTitle  String
  rawArtist String?
  notes     String? @db.Text

  normalizedTitle String
  /// Empty string — never NULL — when no artist was supplied. Postgres treats
  /// NULLs as distinct in a unique index, so a nullable column here would
  /// silently allow duplicate artist-less requests, which is the exact thing
  /// this constraint exists to prevent.
  normalizedArtist String @default("")

  status RequestStatus @default(PENDING)

  /// Populated once the request is matched to (or produces) a song.
  songId String?
  song   Song?   @relation(fields: [songId], references: [id], onDelete: SetNull)

  /// Number of distinct submissions folded into this request.
  requestCount Int @default(1)

  /// Coarse client fingerprint for rate limiting + abuse triage. Hashed, never raw IP.
  submitterHash String?
  resolutionNote String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([normalizedTitle, normalizedArtist], name: "request_identity")
  @@index([status])
  @@index([createdAt])
  @@index([songId])
  @@map("song_requests")
}

/// Immutable snapshots. Reviews are never silently overwritten — a re-review
/// writes a new row here before the live record changes.
model ReviewHistory {
  id String @id @default(cuid())

  songId   String?
  song     Song?   @relation(fields: [songId], references: [id], onDelete: Cascade)
  artistId String?
  artist   Artist? @relation(fields: [artistId], references: [id], onDelete: Cascade)

  reviewVersion      String
  scoringVersion     String
  methodologyVersion String

  overallScore Int?
  /// Full snapshot: scores, findings, scripture, sources at time of review.
  snapshot     Json
  changeNote   String? @db.Text

  createdAt DateTime @default(now())

  @@index([songId])
  @@index([artistId])
  @@index([createdAt])
  @@map("review_history")
}

/// Append-only record of privileged actions.
model AdminAuditLog {
  id        String   @id @default(cuid())
  actor     String
  action    String
  target    String?
  detail    Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([action])
  @@map("admin_audit_log")
}

/// Persistent, cross-instance rate limiting for public write endpoints.
model RateLimitBucket {
  key       String   @id
  count     Int      @default(0)
  expiresAt DateTime
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
  @@map("rate_limit_buckets")
}
